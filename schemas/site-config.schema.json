{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifnei-hakalpi.local/schemas/site-config.schema.json",
  "title": "config/site.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "siteVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "currentElection": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "elections": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "storageKeyPrefix": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  },
  "required": [
    "schemaVersion",
    "siteVersion",
    "currentElection",
    "elections",
    "storageKeyPrefix"
  ],
  "additionalProperties": false
}
