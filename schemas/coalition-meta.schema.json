{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifnei-hakalpi.local/schemas/coalition-meta.schema.json",
  "title": "coalition/meta.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "issue": {
      "type": "string",
      "minLength": 1
    },
    "qt": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]+$"
      },
      "additionalProperties": {
        "$ref": "https://lifnei-hakalpi.local/schemas/coalition-cells.schema.json#/$defs/text"
      }
    },
    "coalQuestions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "issue",
    "qt",
    "coalQuestions"
  ],
  "additionalProperties": false
}
