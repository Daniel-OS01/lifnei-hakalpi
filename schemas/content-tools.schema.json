{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifnei-hakalpi.local/schemas/content-tools.schema.json",
  "title": "Other tools shown in the tools tab (data/elections/<id>/content/tools.json)",
  "type": "object",
  "required": ["tools"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "u", "d", "p", "c"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "string", "minLength": 1, "description": "Tool name" },
          "u": { "type": "string", "pattern": "^https://", "description": "Tool URL" },
          "d": { "type": "string", "minLength": 1, "description": "Description" },
          "p": { "type": "string", "minLength": 1, "description": "Advantage" },
          "c": { "type": "string", "minLength": 1, "description": "Drawback" }
        }
      }
    }
  }
}
